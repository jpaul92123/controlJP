extends layout

block content
  // Cabecera con resumen
  .row.mb-4
    .col-md-8
      h1.mb-0
        i.bi.bi-arrow-up-circle.text-success.me-2
        | Registro de Ingresos
      p.text-muted.mt-2 Gestión completa de todos los ingresos de la empresa
    .col-md-4.text-end
      a.btn.btn-primary.btn-lg(href="/ingresos/nuevo")
        i.bi.bi-plus-circle.me-2
        | Nuevo Ingreso

  // Tarjetas de resumen (se actualizan dinámicamente)
  .row.mb-4#resumenTarjetas
    .col-md-4
      .card.border-0.shadow-sm
        .card-body
          .d-flex.justify-content-between.align-items-center
            div
              h6.text-muted.mb-1 Total Ingresos
              h2.mb-0.text-success#totalIngresos S/ 0.00
            .bg-success.bg-opacity-10.rounded-circle.p-3
              i.bi.bi-cash-stack.text-success.fs-4
    .col-md-4
      .card.border-0.shadow-sm
        .card-body
          .d-flex.justify-content-between.align-items-center
            div
              h6.text-muted.mb-1 N° de Registros
              h2.mb-0.text-primary#cantidadRegistros 0
            .bg-primary.bg-opacity-10.rounded-circle.p-3
              i.bi.bi-list-ul.text-primary.fs-4
    .col-md-4
      .card.border-0.shadow-sm
        .card-body
          .d-flex.justify-content-between.align-items-center
            div
              h6.text-muted.mb-1 Promedio por Ingreso
              h2.mb-0.text-info#promedioIngresos S/ 0.00
            .bg-info.bg-opacity-10.rounded-circle.p-3
              i.bi.bi-calculator.text-info.fs-4

  // Filtros y búsqueda (con búsqueda automática)
  .card.border-0.shadow-sm.mb-4
    .card-body
      form#filtroForm
        .row.g-3
          .col-md-3
            label.form-label.fw-semibold
              i.bi.bi-search.me-1
              | Buscar
            .input-group
              span.input-group-text.bg-light
                i.bi.bi-search
              input.form-control#buscarInput(
                type="text", 
                placeholder="Descripción...", 
                value=buscar,
                autofocus
              )
          .col-md-3
            label.form-label.fw-semibold
              i.bi.bi-tag.me-1
              | Tipo de Ingreso
            select.form-control#tipoInput
              option(value="") Todos los tipos
              each tipo in ['Venta de productos', 'Servicio de instalación', 'Servicio de mantenimiento', 'Adelanto de proyecto', 'Pago de proyecto', 'Otros servicios', 'Préstamo recibido', 'Aporte de capital', 'Otros ingresos']
                option(value=tipo, selected=(tipoSeleccionado === tipo))= tipo
          .col-md-2
            label.form-label.fw-semibold
              i.bi.bi-calendar-event.me-1
              | Desde
            input.form-control#fechaInicioInput(type="date", value=fechaInicio)
          .col-md-2
            label.form-label.fw-semibold
              i.bi.bi-calendar-event.me-1
              | Hasta
            input.form-control#fechaFinInput(type="date", value=fechaFin)
          .col-md-2
            label.form-label.fw-semibold
              i.bi.bi-arrow-down-up.me-1
              | Orden
            select.form-control#ordenInput
              option(value="1") Más antiguos primero
              option(value="-1", selected=(orden === '-1' || !orden)) Más nuevos primero
          .col-md-12.text-end.mt-2
            button.btn.btn-outline-secondary(type="button", onclick="limpiarFiltros()")
              i.bi.bi-x-circle.me-1
              | Limpiar todos los filtros

  // Tabla de ingresos
  .card.border-0.shadow-sm
    .card-header.bg-white.py-3
      .d-flex.justify-content-between.align-items-center
        h5.mb-0.fw-bold
          i.bi.bi-table.me-2
          | Listado de Ingresos
        span.badge.bg-primary.rounded-pill#totalRegistros 0 registros
    .card-body.p-0
      #tablaContainer
        //- La tabla se renderiza aquí mediante JavaScript

  // Script para búsqueda en tiempo real
  script.
    // Variables globales
    let timeoutBusqueda = null;
    const buscarInput = document.getElementById('buscarInput');
    const tipoInput = document.getElementById('tipoInput');
    const fechaInicioInput = document.getElementById('fechaInicioInput');
    const fechaFinInput = document.getElementById('fechaFinInput');
    const ordenInput = document.getElementById('ordenInput');
    const tablaContainer = document.getElementById('tablaContainer');
    const totalIngresos = document.getElementById('totalIngresos');
    const cantidadRegistros = document.getElementById('cantidadRegistros');
    const promedioIngresos = document.getElementById('promedioIngresos');
    const totalRegistros = document.getElementById('totalRegistros');

    // Función para cargar datos con filtros
    async function cargarDatos() {
      const buscar = buscarInput.value.trim();
      const tipo = tipoInput.value;
      const fechaInicio = fechaInicioInput.value;
      const fechaFin = fechaFinInput.value;
      const orden = ordenInput.value;

      // Mostrar indicador de carga
      tablaContainer.innerHTML = `
        <div class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
          </div>
          <p class="text-muted mt-2">Buscando ingresos...</p>
        </div>
      `;

      try {
        // Construir URL con parámetros
        const params = new URLSearchParams();
        if (buscar) params.append('buscar', buscar);
        if (tipo) params.append('tipo', tipo);
        if (fechaInicio) params.append('fechaInicio', fechaInicio);
        if (fechaFin) params.append('fechaFin', fechaFin);
        if (orden) params.append('orden', orden);
        
        const url = `/ingresos/api?${params.toString()}`;
        const response = await fetch(url);
        
        if (!response.ok) throw new Error('Error al cargar datos');
        
        const data = await response.json();
        
        // Actualizar tarjetas de resumen
        totalIngresos.textContent = `S/ ${data.total.toFixed(2)}`;
        cantidadRegistros.textContent = data.cantidad;
        promedioIngresos.textContent = data.cantidad > 0 ? `S/ ${(data.total / data.cantidad).toFixed(2)}` : 'S/ 0.00';
        totalRegistros.textContent = `${data.cantidad} registros`;

        // Renderizar tabla
        if (data.ingresos && data.ingresos.length > 0) {
          let html = `
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                  <tr>
                    <th style="min-width: 160px">
                      <i class="bi bi-calendar3 me-1"></i>Fecha y Hora
                    </th>
                    <th style="min-width: 150px">
                      <i class="bi bi-tag me-1"></i>Tipo
                    </th>
                    <th>
                      <i class="bi bi-file-text me-1"></i>Descripción
                    </th>
                    <th style="min-width: 120px">
                      <i class="bi bi-cash me-1"></i>Monto
                    </th>
                    <th style="min-width: 130px">
                      <i class="bi bi-credit-card me-1"></i>Medio Pago
                    </th>
                    <th style="min-width: 120px">
                      <i class="bi bi-wallet2 me-1"></i>Destino
                    </th>
                    <th style="min-width: 100px" class="text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody>
          `;

          data.ingresos.forEach(ingreso => {
            // Usar la fecha formateada que viene del backend (incluye hora)
            const fechaConHora = ingreso.fechaFormateada || 'Sin fecha';
            
            html += `
              <tr>
                <td><span class="fw-semibold">${fechaConHora}</span></td>
                <td><span class="badge bg-success bg-opacity-10 text-success p-2">${ingreso.tipo}</span></td>
                <td>
                  <div class="fw-semibold">${ingreso.descripcion}</div>
                  ${ingreso.observacion ? `<small class="text-muted"><i class="bi bi-chat me-1"></i>${ingreso.observacion}</small>` : ''}
                </td>
                <td><span class="fw-bold text-success">S/ ${ingreso.monto.toFixed(2)}</span></td>
                <td><span class="badge bg-info bg-opacity-10 text-info">${ingreso.medioPago}</span></td>
                <td><span class="badge bg-primary bg-opacity-10 text-primary">${ingreso.destino || 'No especificado'}</span></td>
                <td>
                  <div class="d-flex justify-content-center gap-1">
                    <a class="btn btn-sm btn-outline-warning" href="/ingresos/${ingreso._id}/editar" title="Editar">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form class="d-inline" action="/ingresos/${ingreso._id}?_method=DELETE" method="post" onsubmit="return confirm('¿Estás seguro de eliminar este ingreso?')">
                      <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            `;
          });

          html += `
                </tbody>
              </table>
            </div>
          `;

          tablaContainer.innerHTML = html;
        } else {
          tablaContainer.innerHTML = `
            <div class="text-center py-5">
              <i class="bi bi-inbox text-muted fs-1 d-block mb-3"></i>
              <h5 class="text-muted">No hay ingresos que coincidan con tu búsqueda</h5>
              <p class="text-muted">Prueba con otros términos o limpia los filtros</p>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error:', error);
        tablaContainer.innerHTML = `
          <div class="text-center py-5 text-danger">
            <i class="bi bi-exclamation-triangle fs-1 d-block mb-3"></i>
            <h5>Error al cargar los datos</h5>
            <p>Por favor, intenta nuevamente</p>
          </div>
        `;
      }
    }

    // Función para limpiar filtros
    function limpiarFiltros() {
      buscarInput.value = '';
      tipoInput.value = '';
      fechaInicioInput.value = '';
      fechaFinInput.value = '';
      ordenInput.value = '1'; // Restaurar a "más antiguos primero"
      cargarDatos();
    }

    // Evento de búsqueda con debounce (300ms)
    buscarInput.addEventListener('input', function() {
      clearTimeout(timeoutBusqueda);
      timeoutBusqueda = setTimeout(() => {
        cargarDatos();
      }, 300);
    });

    // Eventos para cambios en tipo, fechas y orden (actualización inmediata)
    tipoInput.addEventListener('change', cargarDatos);
    fechaInicioInput.addEventListener('change', cargarDatos);
    fechaFinInput.addEventListener('change', cargarDatos);
    ordenInput.addEventListener('change', cargarDatos);

    // Cargar datos iniciales
    document.addEventListener('DOMContentLoaded', cargarDatos);