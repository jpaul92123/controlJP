extends layout

block content
  .card.border-0.shadow-sm
    .card-header.bg-white.py-3
      h4.mb-0.fw-bold
        i.bi.bi-arrow-up-circle.text-success.me-2
        = ingreso ? '✏️ Editar Ingreso' : '➕ Nuevo Ingreso'
    .card-body
      form(action=ingreso ? `/ingresos/${ingreso._id}?_method=PUT` : '/ingresos', method="post", id="formIngreso")
        .row.g-3
          .col-md-6
            // FECHA
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-calendar-event.me-1
                | Fecha
              input.form-control(
                type="date", 
                name="fecha", 
                value=ingreso ? formatDateInput(ingreso.fecha) : '',
                required
              )
            
            // HORA (NUEVO CAMPO)
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-clock.me-1
                | Hora
              input.form-control(
                type="time", 
                name="hora", 
                value=ingreso ? ingreso.hora || '00:00' : '00:00',
                step="60"
              )
              small.text-muted Formato 24 horas (ej: 14:30)
            
            // TIPO DE INGRESO
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-tag.me-1
                | Tipo de Ingreso
              select.form-control(name="tipo", required)
                option(value="") Seleccione un tipo
                each tipo in ['Venta de productos', 'Servicio de instalación', 'Servicio de mantenimiento', 'Adelanto de proyecto', 'Pago de proyecto', 'Otros servicios', 'Préstamo recibido', 'Aporte de capital', 'Otros ingresos']
                  option(value=tipo, selected=(ingreso && ingreso.tipo === tipo))= tipo
            
            // DESCRIPCIÓN
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-file-text.me-1
                | Descripción
              input.form-control(
                type="text", 
                name="descripcion", 
                placeholder="Ej: Venta de cámaras de seguridad", 
                value=ingreso ? ingreso.descripcion : '',
                required
              )
          
          .col-md-6
            // MONTO
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-cash.me-1
                | Monto (S/)
              input.form-control(
                type="number", 
                step="0.01", 
                name="monto", 
                placeholder="0.00", 
                value=ingreso ? ingreso.monto : '',
                min="0.01",
                required
              )
            
            // MEDIO DE PAGO
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-credit-card.me-1
                | Medio de Pago
              select.form-control(name="medioPago")
                each medio in ['Efectivo', 'Transferencia', 'Tarjeta', 'Yape/Plin', 'Otro']
                  option(value=medio, selected=(ingreso && ingreso.medioPago === medio))= medio
            
            // DESTINO DEL DINERO
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-wallet2.me-1
                | Destino del Dinero
              select.form-control(name="destino")
                each destino in ['Efectivo', 'BCP', 'Interbank', 'Bim', 'Scotiabank', 'Otro']
                  option(value=destino, selected=(ingreso && ingreso.destino === destino))= destino
        
        // OBSERVACIÓN
        .mb-3
          label.form-label.fw-semibold
            i.bi.bi-chat.me-1
            | Observación
          textarea.form-control(
            name="observacion", 
            rows="2", 
            placeholder="Detalles adicionales..."
          )= ingreso ? ingreso.observacion : ''
        
        // BOTONES
        .d-flex.gap-2.mt-3
          button.btn.btn-primary(type="submit")
            i.bi.bi-check-circle.me-1
            | Guardar
          a.btn.btn-secondary(href="/ingresos")
            i.bi.bi-x-circle.me-1
            | Cancelar

  // Script para validación y manejo de fechas
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('formIngreso');
      
      // Validar antes de enviar
      form.addEventListener('submit', function(e) {
        const monto = document.querySelector('input[name="monto"]');
        const descripcion = document.querySelector('input[name="descripcion"]');
        const tipo = document.querySelector('select[name="tipo"]');
        
        // Validar monto
        if (parseFloat(monto.value) <= 0) {
          e.preventDefault();
          alert('❌ El monto debe ser mayor a 0');
          monto.focus();
          return false;
        }
        
        // Validar descripción
        if (descripcion.value.trim() === '') {
          e.preventDefault();
          alert('❌ La descripción es obligatoria');
          descripcion.focus();
          return false;
        }
        
        // Validar tipo
        if (tipo.value === '') {
          e.preventDefault();
          alert('❌ Debes seleccionar un tipo de ingreso');
          tipo.focus();
          return false;
        }
        
        // Validar fecha
        const fecha = document.querySelector('input[name="fecha"]');
        if (!fecha.value) {
          e.preventDefault();
          alert('❌ Debes seleccionar una fecha');
          fecha.focus();
          return false;
        }
        
        // Mostrar datos que se van a guardar (debug)
        console.log('📅 Datos del formulario:');
        console.log('Fecha:', fecha.value);
        console.log('Hora:', document.querySelector('input[name="hora"]').value);
        console.log('Tipo:', tipo.value);
        console.log('Descripción:', descripcion.value);
        console.log('Monto:', monto.value);
      });
    });