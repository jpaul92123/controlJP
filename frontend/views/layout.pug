doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title

    //- BOOTSTRAP CSS (LOCAL)
    link(rel="stylesheet", href="/bootstrap/css/bootstrap.min.css")

    //- BOOTSTRAP ICONS (CDN)
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")

    //- NUESTRO CSS PERSONALIZADO
    link(rel="stylesheet", href="/css/style.css")

    //- CHART.JS (CDN)
    script(src="https://cdn.jsdelivr.net/npm/chart.js")

  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      .container
        a.navbar-brand(href="/")
          i.bi.bi-shield-lock-fill.me-2
          | JP Security — Control Financiero
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        .collapse.navbar-collapse#navbarNav
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link(href="/")
                i.bi.bi-speedometer2.me-1
                | Dashboard
            li.nav-item
              a.nav-link(href="/ingresos")
                i.bi.bi-arrow-up-circle.me-1
                | Ingresos
            li.nav-item
              a.nav-link(href="/egresos")
                i.bi.bi-arrow-down-circle.me-1
                | Egresos
            li.nav-item.dropdown
              a.nav-link.dropdown-toggle(href="#", role="button", data-bs-toggle="dropdown")
                i.bi.bi-calendar3.me-1
                | Cronograma
              ul.dropdown-menu
                li
                  a.dropdown-item(href="/cronograma")
                    i.bi.bi-calendar-range.me-1
                    | Calendario
                li
                  a.dropdown-item(href="/prestamos")
                    i.bi.bi-bank.me-1
                    | Préstamos
                li
                  a.dropdown-item(href="/pagos-servicios")
                    i.bi.bi-building.me-1
                    | Servicios

    .container.mt-4
      block content

    //- BOOTSTRAP JS (LOCAL)
    script(src="/bootstrap/js/bootstrap.bundle.min.js")