extends layout

block content
  // Cabecera con resumen
  .row.mb-4
    .col-md-8
      h1.mb-0
        i.bi.bi-arrow-down-circle.text-danger.me-2
        | Registro de Egresos
      p.text-muted.mt-2 Gestión completa de todos los egresos de la empresa
    .col-md-4.text-end
      a.btn.btn-danger.btn-lg(href="/egresos/nuevo")
        i.bi.bi-plus-circle.me-2
        | Nuevo Egreso

  // Tarjetas de resumen (se actualizan dinámicamente)
  .row.mb-4#resumenTarjetas
    .col-md-4
      .card.border-0.shadow-sm
        .card-body
          .d-flex.justify-content-between.align-items-center
            div
              h6.text-muted.mb-1 Total Egresos
              h2.mb-0.text-danger#totalEgresos S/ 0.00
            .bg-danger.bg-opacity-10.rounded-circle.p-3
              i.bi.bi-cash-stack.text-danger.fs-4
    .col-md-4
      .card.border-0.shadow-sm
        .card-body
          .d-flex.justify-content-between.align-items-center
            div
              h6.text-muted.mb-1 N° de Registros
              h2.mb-0.text-primary#cantidadRegistros 0
            .bg-primary.bg-opacity-10.rounded-circle.p-3
              i.bi.bi-list-ul.text-primary.fs-4
    .col-md-4
      .card.border-0.shadow-sm
        .card-body
          .d-flex.justify-content-between.align-items-center
            div
              h6.text-muted.mb-1 Promedio por Egreso
              h2.mb-0.text-info#promedioEgresos S/ 0.00
            .bg-info.bg-opacity-10.rounded-circle.p-3
              i.bi.bi-calculator.text-info.fs-4

  // Filtros y búsqueda (con búsqueda automática)
  .card.border-0.shadow-sm.mb-4
    .card-body
      form#filtroForm
        .row.g-3
          .col-md-3
            label.form-label.fw-semibold
              i.bi.bi-search.me-1
              | Buscar
            .input-group
              span.input-group-text.bg-light
                i.bi.bi-search
              input.form-control#buscarInput(
                type="text", 
                placeholder="Descripción...", 
                value=buscar,
                autofocus
              )
          .col-md-3
            label.form-label.fw-semibold
              i.bi.bi-tag.me-1
              | Categoría
            select.form-control#categoriaInput
              option(value="") Todas las categorías
              each cat in ['Compra de mercadería', 'Compra de equipos', 'Compra de materiales', 'Compra de herramientas', 'Pago de personal', 'Adelanto de personal', 'Honorarios', 'Combustible', 'Pasajes', 'Taxi/movilidad', 'Peajes', 'Estacionamiento', 'Alimentación', 'Servicios', 'Internet', 'Telefonía', 'Alquiler', 'Publicidad', 'Software', 'Otros', 'Pago de préstamo', 'Intereses', 'Comisiones bancarias', 'Otros gastos']
                option(value=cat, selected=(categoriaSeleccionada === cat))= cat
          .col-md-2
            label.form-label.fw-semibold
              i.bi.bi-calendar-event.me-1
              | Desde
            input.form-control#fechaInicioInput(type="date", value=fechaInicio)
          .col-md-2
            label.form-label.fw-semibold
              i.bi.bi-calendar-event.me-1
              | Hasta
            input.form-control#fechaFinInput(type="date", value=fechaFin)
          .col-md-2
            label.form-label.fw-semibold
              i.bi.bi-arrow-down-up.me-1
              | Orden
            select.form-control#ordenInput
              option(value="1") Más antiguos primero
              option(value="-1", selected=(orden === '-1' || !orden)) Más nuevos primero
          .col-md-12.text-end.mt-2
            button.btn.btn-outline-secondary(type="button", onclick="limpiarFiltros()")
              i.bi.bi-x-circle.me-1
              | Limpiar todos los filtros

  // Tabla de egresos
  .card.border-0.shadow-sm
    .card-header.bg-white.py-3
      .d-flex.justify-content-between.align-items-center
        h5.mb-0.fw-bold
          i.bi.bi-table.me-2
          | Listado de Egresos
        span.badge.bg-danger.rounded-pill#totalRegistros 0 registros
    .card-body.p-0
      #tablaContainer
        //- La tabla se renderiza aquí mediante JavaScript

  // Script para búsqueda en tiempo real
  script.
    // Variables globales
    let timeoutBusqueda = null;
    const buscarInput = document.getElementById('buscarInput');
    const categoriaInput = document.getElementById('categoriaInput');
    const fechaInicioInput = document.getElementById('fechaInicioInput');
    const fechaFinInput = document.getElementById('fechaFinInput');
    const ordenInput = document.getElementById('ordenInput');
    const tablaContainer = document.getElementById('tablaContainer');
    const totalEgresos = document.getElementById('totalEgresos');
    const cantidadRegistros = document.getElementById('cantidadRegistros');
    const promedioEgresos = document.getElementById('promedioEgresos');
    const totalRegistros = document.getElementById('totalRegistros');

    // Función para cargar datos con filtros
    async function cargarDatos() {
      const buscar = buscarInput.value.trim();
      const categoria = categoriaInput.value;
      const fechaInicio = fechaInicioInput.value;
      const fechaFin = fechaFinInput.value;
      const orden = ordenInput.value;

      // Mostrar indicador de carga
      tablaContainer.innerHTML = `
        <div class="text-center py-5">
          <div class="spinner-border text-danger" role="status">
            <span class="visually-hidden">Cargando...</span>
          </div>
          <p class="text-muted mt-2">Buscando egresos...</p>
        </div>
      `;

      try {
        // Construir URL con parámetros
        const params = new URLSearchParams();
        if (buscar) params.append('buscar', buscar);
        if (categoria) params.append('categoria', categoria);
        if (fechaInicio) params.append('fechaInicio', fechaInicio);
        if (fechaFin) params.append('fechaFin', fechaFin);
        if (orden) params.append('orden', orden);
        
        const url = `/egresos/api?${params.toString()}`;
        const response = await fetch(url);
        
        if (!response.ok) throw new Error('Error al cargar datos');
        
        const data = await response.json();
        
        // Actualizar tarjetas de resumen
        totalEgresos.textContent = `S/ ${data.total.toFixed(2)}`;
        cantidadRegistros.textContent = data.cantidad;
        promedioEgresos.textContent = data.cantidad > 0 ? `S/ ${(data.total / data.cantidad).toFixed(2)}` : 'S/ 0.00';
        totalRegistros.textContent = `${data.cantidad} registros`;

        // Renderizar tabla
        if (data.egresos && data.egresos.length > 0) {
          let html = `
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                  <tr>
                    <th style="min-width: 160px">
                      <i class="bi bi-calendar3 me-1"></i>Fecha y Hora
                    </th>
                    <th style="min-width: 150px">
                      <i class="bi bi-tag me-1"></i>Categoría
                    </th>
                    <th>
                      <i class="bi bi-file-text me-1"></i>Descripción
                    </th>
                    <th style="min-width: 120px">
                      <i class="bi bi-cash me-1"></i>Monto
                    </th>
                    <th style="min-width: 130px">
                      <i class="bi bi-credit-card me-1"></i>Medio Pago
                    </th>
                    <th style="min-width: 120px">
                      <i class="bi bi-wallet2 me-1"></i>Origen
                    </th>
                    <th style="min-width: 120px">
                      <i class="bi bi-link me-1"></i>Referencia
                    </th>
                    <th style="min-width: 100px" class="text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody>
          `;

          data.egresos.forEach(egreso => {
            // Usar la fecha formateada que viene del backend (incluye hora)
            const fechaConHora = egreso.fechaFormateada || 'Sin fecha';
            
            // Determinar badge de referencia
            let referenciaBadge = '';
            if (egreso.tipoReferencia === 'prestamo') {
              referenciaBadge = `<span class="badge bg-success"><i class="bi bi-bank me-1"></i>Préstamo</span>`;
            } else if (egreso.tipoReferencia === 'servicio') {
              referenciaBadge = `<span class="badge bg-info"><i class="bi bi-building me-1"></i>Servicio</span>`;
            } else {
              referenciaBadge = `<span class="badge bg-secondary"><i class="bi bi-dash me-1"></i>Manual</span>`;
            }
            
            html += `
              <tr>
                <td><span class="fw-semibold">${fechaConHora}</span></td>
                <td><span class="badge bg-danger bg-opacity-10 text-danger p-2">${egreso.categoria}</span></td>
                <td>
                  <div class="fw-semibold">${egreso.descripcion}</div>
                  ${egreso.observacion ? `<small class="text-muted"><i class="bi bi-chat me-1"></i>${egreso.observacion}</small>` : ''}
                </td>
                <td><span class="fw-bold text-danger">S/ ${egreso.monto.toFixed(2)}</span></td>
                <td><span class="badge bg-info bg-opacity-10 text-info">${egreso.medioPago}</span></td>
                <td><span class="badge bg-warning bg-opacity-10 text-warning">${egreso.origen || 'No especificado'}</span></td>
                <td>${referenciaBadge}</td>
                <td>
                  <div class="d-flex justify-content-center gap-1">
                    <a class="btn btn-sm btn-outline-warning" href="/egresos/${egreso._id}/editar" title="Editar">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form class="d-inline" action="/egresos/${egreso._id}?_method=DELETE" method="post" onsubmit="return confirm('¿Estás seguro de eliminar este egreso?\\n\\n⚠️ Si es de un préstamo o servicio, se restaurará automáticamente.')">
                      <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            `;
          });

          html += `
                </tbody>
              </table>
            </div>
          `;

          tablaContainer.innerHTML = html;
        } else {
          tablaContainer.innerHTML = `
            <div class="text-center py-5">
              <i class="bi bi-inbox text-muted fs-1 d-block mb-3"></i>
              <h5 class="text-muted">No hay egresos que coincidan con tu búsqueda</h5>
              <p class="text-muted">Prueba con otros términos o limpia los filtros</p>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error:', error);
        tablaContainer.innerHTML = `
          <div class="text-center py-5 text-danger">
            <i class="bi bi-exclamation-triangle fs-1 d-block mb-3"></i>
            <h5>Error al cargar los datos</h5>
            <p>Por favor, intenta nuevamente</p>
          </div>
        `;
      }
    }

    // Función para limpiar filtros
    function limpiarFiltros() {
      buscarInput.value = '';
      categoriaInput.value = '';
      fechaInicioInput.value = '';
      fechaFinInput.value = '';
      ordenInput.value = '1';
      cargarDatos();
    }

    // Evento de búsqueda con debounce (300ms)
    buscarInput.addEventListener('input', function() {
      clearTimeout(timeoutBusqueda);
      timeoutBusqueda = setTimeout(() => {
        cargarDatos();
      }, 300);
    });

    // Eventos para cambios en categoría, fechas y orden
    categoriaInput.addEventListener('change', cargarDatos);
    fechaInicioInput.addEventListener('change', cargarDatos);
    fechaFinInput.addEventListener('change', cargarDatos);
    ordenInput.addEventListener('change', cargarDatos);

    // Cargar datos iniciales
    document.addEventListener('DOMContentLoaded', cargarDatos);