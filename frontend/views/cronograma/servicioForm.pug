extends ../layout

block content
  .card.border-0.shadow-sm
    .card-header.bg-white.py-3
      h4.mb-0.fw-bold
        i.bi.bi-building.text-info.me-2
        = servicio ? '✏️ Editar Servicio' : '➕ Nuevo Servicio'
    .card-body
      form(
        action=servicio ? `/pagos-servicios/${servicio._id}?_method=PUT` : '/pagos-servicios',
        method="post"
      )
        .row.g-3
          .col-md-6
            // NOMBRE DEL SERVICIO
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-tag.me-1
                | Nombre del Servicio
              input.form-control(
                type="text",
                name="nombre",
                placeholder="Ej: Luz de Septiembre",
                value=servicio ? servicio.nombre : '',
                required
              )
            
            // CATEGORÍA
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-tags.me-1
                | Categoría
              select.form-control(name="categoria", required)
                option(value="") Seleccione una categoría
                each cat in ['Agua', 'Luz', 'Internet', 'Teléfono', 'Gas', 'Alquiler', 'Mantenimiento', 'Seguro', 'Otro']
                  option(value=cat, selected=(servicio && servicio.categoria === cat))= cat
            
            // FECHA DE VENCIMIENTO
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-calendar-event.me-1
                | Fecha de Vencimiento
              input.form-control(
                type="date",
                name="fechaVencimiento",
                value=servicio ? formatDateInput(servicio.fechaVencimiento) : '',
                required
              )
          
          .col-md-6
            // MONTO
            .mb-3
              label.form-label.fw-semibold
                i.bi.bi-cash.me-1
                | Monto a Pagar
              input.form-control(
                type="number",
                step="0.01",
                name="monto",
                placeholder="0.00",
                value=servicio ? servicio.monto : '',
                min="0.01",
                required
              )
            
            // CHECKBOX: SERVICIO RECURRENTE
            .mb-3
              .form-check.form-switch
                input.form-check-input(
                  type="checkbox",
                  name="esRecurrente",
                  id="esRecurrente",
                  checked=(servicio && servicio.esRecurrente === true ? true : false)
                )
                label.form-check-label.fw-semibold(for="esRecurrente")
                  i.bi.bi-arrow-repeat.me-1
                  | Servicio Recurrente
                br
                small.text-muted Si está activado, al pagar se generará automáticamente el mismo servicio para el mes siguiente
        
        // OBSERVACIÓN
        .mb-3
          label.form-label.fw-semibold
            i.bi.bi-chat.me-1
            | Observación
          textarea.form-control(
            name="observacion",
            rows="2",
            placeholder="Detalles adicionales..."
          )= servicio ? servicio.observacion : ''
        
        // BOTONES
        .d-flex.gap-2.mt-3
          button.btn.btn-info(type="submit")
            i.bi.bi-check-circle.me-1
            | Guardar
          a.btn.btn-secondary(href="/cronograma")
            i.bi.bi-x-circle.me-1
            | Cancelar
        
        // SI ES EDICIÓN, MOSTRAR INFORMACIÓN ADICIONAL
        if servicio
          .mt-3
            hr
            .row
              .col-6
                strong Estado:
                |  #{servicio.estado || 'Pendiente'}
              .col-6
                strong Pagos realizados:
                |  #{servicio.pagos ? servicio.pagos.length : 0}
              if servicio.esRecurrente
                .col-12.mt-2
                  .alert.alert-info
                    i.bi.bi-info-circle.me-1
                    | Este servicio es recurrente. Se generará automáticamente cada mes.
              if servicio.pagos && servicio.pagos.length > 0
                .col-12.mt-2
                  .alert.alert-warning
                    i.bi.bi-exclamation-triangle.me-1
                    | Este servicio tiene pagos registrados. No se puede eliminar completamente, solo editar.

  // Script
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const checkbox = document.getElementById('esRecurrente');
      if (checkbox) {
        checkbox.addEventListener('change', function() {
          if (this.checked) {
            console.log('✅ Servicio recurrente activado');
          } else {
            console.log('❌ Servicio no recurrente');
          }
        });
      }
      
      // Validación del formulario
      const form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', function(e) {
          const nombre = document.querySelector('input[name="nombre"]');
          const monto = document.querySelector('input[name="monto"]');
          const fecha = document.querySelector('input[name="fechaVencimiento"]');
          
          if (nombre && nombre.value.trim() === '') {
            e.preventDefault();
            alert('❌ El nombre del servicio es obligatorio');
            nombre.focus();
            return false;
          }
          
          if (monto && parseFloat(monto.value) <= 0) {
            e.preventDefault();
            alert('❌ El monto debe ser mayor a 0');
            monto.focus();
            return false;
          }
          
          if (fecha && !fecha.value) {
            e.preventDefault();
            alert('❌ La fecha de vencimiento es obligatoria');
            fecha.focus();
            return false;
          }
          
          return true;
        });
      }
    });